rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every collection gates on this — spec 001. Requires not just a
    // signed-in client but a verified one, since email/password sign-ups
    // start unverified.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/transactions/{transactionId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/categories/{categoryId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/budgets/{budgetId} {
      allow read, write: if isOwner(uid);
    }
  }
}
