rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every collection gates on this — spec 001. Requires not just a
    // signed-in client but a verified one, since email/password sign-ups
    // start unverified.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/transactions/{transactionId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/categories/{categoryId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/budgets/{budgetId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/debts/{debtId} {
      allow read, write: if isOwner(uid);
    }

    // Spec 012 — the overdraft line settings doc and its event ledger.
    match /users/{uid}/overdraft/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/overdraftEvents/{eventId} {
      allow read, write: if isOwner(uid);
    }

    // Spec 013 — the credit card entity and its (payments-only) ledger.
    match /users/{uid}/creditCards/{cardId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/creditCardPayments/{paymentId} {
      allow read, write: if isOwner(uid);
    }
  }
}
